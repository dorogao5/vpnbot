BOT_TOKEN=123456:replace_me
ADMIN_TELEGRAM_ID=123456789
CONTACT_URL=https://t.me/ralfy
POSTGRES_DB=vpnbot
POSTGRES_USER=vpnbot
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://vpnbot:replace_with_a_long_random_password@postgres:5432/vpnbot
TIMEZONE=Europe/Moscow
REMINDER_HOUR=10

# Только запросы Telegram Bot API проходят через этот SOCKS5-прокси.
TELEGRAM_PROXY_URL=
# SSH к VPN-серверам через SOCKS5 (нужно, если RU-хост не видит зарубежные VPS напрямую).
SSH_PROXY_URL=
# Публичный российский endpoint, который relay передаёт реальному OpenVPN-серверу.
VPN_RELAY_HOST=
VPN_RELAY_PORT=443
# Диапазон внешних TCP-портов RU relay для серверов из админки.
VPN_RELAY_PORT_START=4443
VPN_RELAY_PORT_END=4499
# SSH-доступ, которым новый VPS поднимает обратный туннель на RU relay.
VPN_RELAY_SSH_HOST=
VPN_RELAY_SSH_PORT=22
VPN_RELAY_SSH_USER=vpn-relay
VPN_RELAY_TUNNEL_PRIVATE_KEY_PATH=/run/secrets/relay_tunnel_key
VPN_RELAY_HOST_PUBLIC_KEY_PATH=/run/secrets/relay_host_key.pub
# IPv4 или CIDR через запятую: эти адреса используют исходный шлюз пользователя.
VPN_BYPASS_ROUTES=
# Необязательный статический список доменов через запятую. Основной список управляется из админки.
VPN_BYPASS_DOMAINS=
VPN_BLOCK_IPV6=true

# Новый VPS. Этот сервер обязателен для выдачи новых конфигов.
NEW_VPN_NAME=Новый сервер
NEW_VPN_HOST=
NEW_VPN_PORT=22
NEW_VPN_USER=vpn-bot
NEW_VPN_PRIVATE_KEY_PATH=
NEW_VPN_HOST_FINGERPRINT=

# Старый VPS подключается только после проверки и резервного копирования.
OLD_VPN_NAME=Старый сервер
OLD_VPN_HOST=
OLD_VPN_PORT=22
OLD_VPN_USER=vpn-bot
OLD_VPN_PRIVATE_KEY_PATH=
OLD_VPN_HOST_FINGERPRINT=

VPN_HELPER_COMMAND=sudo /usr/local/sbin/openvpn-bot-helper

# Публичный SSH-ключ, который бот прописывает на новых серверах при настройке через админку.
# Пара ключа НЕ совпадает с ключами NEW/OLD: это отдельный ключ для bootstrap.
# Сгенерировать: ssh-keygen -t ed25519 -f secrets/bootstrap_key -N "" -C vpnbot-bootstrap
VPN_BOOTSTRAP_PUBLIC_KEY_PATH=/run/secrets/bootstrap_key.pub
