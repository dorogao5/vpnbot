#!/usr/bin/env bash
set -Eeuo pipefail

ZONE_URL="${RU_ZONE_URL:-https://www.ipdeny.com/ipblocks/data/aggregated/ru-aggregated.zone}"
MIN_PREFIXES="${RU_ZONE_MIN_PREFIXES:-1000}"

zone="$(mktemp)"
batch="$(mktemp)"
trap 'rm -f "$zone" "$batch"' EXIT

curl --fail --silent --show-error --location --max-time 60 "$ZONE_URL" >"$zone"

if ! awk '
  !/^([0-9]{1,3}\.){3}[0-9]{1,3}\/[0-9]{1,2}$/ { exit 1 }
  END { if (NR < minimum) exit 1 }
' minimum="$MIN_PREFIXES" "$zone"; then
  echo "Получен некорректный список российских IPv4-подсетей" >&2
  exit 1
fi

{
  echo "flush set inet vpnbot_geo ru4"
  echo "add element inet vpnbot_geo ru4 {"
  awk '{ lines[NR]=$0 } END { for (i=1; i<=NR; i++) printf "  %s%s\n", lines[i], (i<NR ? "," : "") }' "$zone"
  echo "}"
} >"$batch"

nft --check --file "$batch"
nft --file "$batch"
echo "Загружено российских IPv4-подсетей: $(wc -l <"$zone")"
