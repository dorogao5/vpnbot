{
  "name": "vpnbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.3",
    "grammy": "^1.45.1",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.15.5",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
